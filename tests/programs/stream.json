{
 "name": "测试-流",
 "about": "取 IMU 加速度与姿态角两个流的最新值",
 "steps": [
  {
   "stream": "sensor://imu/acceleration",
   "as": "a"
  },
  {
   "stream": "sensor://imu/orientation",
   "as": "o"
  },
  {
   "write": "device://local/clipboard",
   "content": "z={a.z};pitch={o.pitch};roll={o.roll};"
  },
  {
   "read": "device://local/clipboard"
  }
 ]
}